TARGET_BRANCH=test
GITHUB_REPOSITORY_NAME=devsu-demo-devops-java
GITHUB_SHA=1234

TF_VAR_aws_region=us-east-1
TF_VAR_repository_name=${GITHUB_REPOSITORY_NAME}
TF_VAR_environment=${TARGET_BRANCH}
TF_VAR_port=8000

TF_VAR_health_check_path=/api/users
TF_VAR_path_pattern='["/api/users", "/api/users/*"]'

TF_VAR_image_name=codeparce/${GITHUB_REPOSITORY_NAME}:${GITHUB_SHA}

TF_VAR_backend_infra=devsu/aws-microservice-ecs/${TARGET_BRANCH}_terraform.tfstate
